{
  "name": "visual-novel-studio",
  "version": "0.8.1",
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "description": "Offline visual novel authoring studio",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-desktop.mjs",
    "package": "node scripts/package.mjs",
    "package:portable": "node scripts/package-portable.mjs",
    "sample": "tsx scripts/create-sample.ts",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "spine:build": "node scripts/build-spine-runtime.mjs",
    "spine:build:android": "node scripts/build-spine-android.mjs",
    "template:aihong": "tsx scripts/create-aihong-template.ts --bundle",
    "test:ui-resource-migration-editor": "tsx scripts/verify-ui-resource-migration-editor.ts",
    "test:ui-system-hosts-runtime": "tsx scripts/verify-ui-system-hosts-runtime.ts",
    "test:released-runtime-migration": "tsx scripts/verify-released-runtime-migration.ts",
    "test:released-project-migration": "tsx scripts/verify-released-project-migration.ts",
    "test:blueprint-context-matrix": "tsx scripts/verify-blueprint-context-matrix-editor.ts",
    "test:blueprint-performance-preview": "tsx scripts/verify-blueprint-performance-preview.ts",
    "test:blueprint-task-boundaries": "tsx scripts/verify-blueprint-task-boundaries-runtime.ts",
    "test:blueprint-task-ownership": "tsx scripts/verify-blueprint-task-ownership-runtime.ts",
    "test:ui-spine-editor": "tsx scripts/verify-ui-spine-editor.ts",
    "test:ui-spine-runtime": "tsx scripts/verify-ui-spine-runtime.ts",
    "test:ui-video-editor": "tsx scripts/verify-ui-video-editor.ts",
    "test:ui-video-runtime": "tsx scripts/verify-ui-video-runtime.ts",
    "test:ui-layout-editor": "tsx scripts/verify-ui-layout-editor.ts",
    "test:ui-layout-runtime": "tsx scripts/verify-ui-layout-runtime.ts",
    "test:spine-authoring": "tsx scripts/verify-spine-authoring.ts",
    "test:runtime": "tsx scripts/verify-runtime.ts",
    "test:blueprint-editor": "tsx scripts/verify-blueprint-editor.ts",
    "test:blueprint-runtime": "tsx scripts/verify-blueprint-runtime.ts",
    "test:workbench": "tsx scripts/verify-workbench.ts",
    "test:aihong-story": "tsx scripts/verify-aihong-story.ts",
    "test:live-preview": "node scripts/build-desktop.mjs && tsx scripts/verify-live-preview.ts",
    "test:text-structure": "node scripts/build-desktop.mjs && tsx scripts/verify-text-structure.ts",
    "test:diagnostics": "node scripts/build-desktop.mjs && tsx scripts/verify-diagnostic-navigation.ts"
  },
  "dependencies": {
    "@esotericsoftware/spine-webgl": "~4.2.120",
    "@xyflow/react": "^12.8.6",
    "elkjs": "^0.11.0",
    "fast-xml-parser": "^5.11.1",
    "immer": "11.1.21",
    "lucide-react": "^0.468.0",
    "pinyin-pro": "^3.29.4",
    "pngjs": "7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.10.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^40.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.27.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "studio.visualnovel.desktop",
    "productName": "Visual Novel Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-desktop/**/*",
      "package.json",
      "!node_modules/**/*",
      "!dist/**/*.map",
      "!dist-desktop/**/*.map"
    ],
    "asarUnpack": ["dist-desktop/image-metadata-worker.cjs"],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "example/**",
          "templates/**",
          "runtime/**",
          "single-exe/**",
          "spine/**",
          "tools/**",
          "licenses/**",
          "export-tools.json",
          "SAMPLE-CREDITS.md",
          "THIRD-PARTY-NOTICES.txt",
          "!runtime/tmp/**",
          "!runtime/**/__pycache__/**",
          "!runtime/**/cache/**",
          "!runtime/**/saves/**",
          "!runtime/**/log.txt",
          "!runtime/**/traceback.txt",
          "!runtime/**/errors.txt"
        ]
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "user-guide.md",
          "portable.md",
          "release-0.8.1.md",
          "text-authoring.md",
          "text-presentation.md",
          "blueprint-authoring.md",
          "authoring-tracks-and-parameters.md",
          "character-presets.md",
          "starter-template.md",
          "performance-workspace.md",
          "resource-workspace.md",
          "flow-layout-click-sounds.md",
          "ui-presentation.md",
          "player-settings.md",
          "game-export.md",
          "spine-authoring.md",
          "interaction-authoring.md",
          "ai-assistant.md",
          "aihong-story-sample.md"
        ]
      },
      {
        "from": "docs/README.md",
        "to": "README.md"
      }
    ],
    "toolsets": {
      "nsis": "1.2.1"
    },
    "win": {
      "target": "nsis",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "preCompressedFileExtensions": [".avi", ".mov", ".m4v", ".mp4", ".m4p", ".qt", ".mkv", ".webm", ".vmdk", ".so"],
      "allowToChangeInstallationDirectory": true
    }
  }
}
